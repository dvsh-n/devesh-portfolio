<canvas id="ascii-background" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#ascii-background');
  const context = canvas?.getContext('2d');

  if (canvas && context) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const glyphs = ['.', ',', ':', ';', '-', '~', '='];
    const cellWidth = 12;
    const cellHeight = 18;
    let width = 0;
    let height = 0;
    let frame = 0;
    let lastDraw = 0;
    let elapsed = 0;

    function draw() {
      if (!canvas || !context) return;
      context.clearRect(0, 0, width, height);
      context.font = '11px ui-monospace, Menlo, Consolas, monospace';
      context.textAlign = 'center';
      context.textBaseline = 'middle';

      for (let y = 9; y < height; y += cellHeight) {
        for (let x = 6; x < width; x += cellWidth) {
          // Contours of a slowly bending field, with characters concentrated
          // near its troughs. Empty space separates the curved bands.
          const phase = y / 65 + x / 280
            + 1.35 * Math.sin(x / 250 + elapsed * 0.045)
            + 0.5 * Math.sin((x + y) / 370 - elapsed * 0.025)
            - elapsed * 0.075;
          const depth = Math.pow((1 - Math.cos(phase)) / 2, 7);
          if (depth < 0.045) continue;
          const index = Math.min(glyphs.length - 1, Math.floor(depth * glyphs.length));
          context.fillStyle = `rgba(157, 178, 187, ${0.025 + depth * 0.13})`;
          context.fillText(glyphs[index], x, y);
        }
      }
    }

    function resize() {
      if (!canvas || !context) return;
      width = window.innerWidth;
      height = window.innerHeight;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw();
    }

    function animate(now: number) {
      if (now - lastDraw >= 1000 / 12) {
        // Cap the delta so resuming a hidden tab never jumps the pattern.
        elapsed += Math.min((now - lastDraw) / 1000, 0.15);
        lastDraw = now;
        draw();
      }
      frame = window.requestAnimationFrame(animate);
    }

    function updateMotion() {
      window.cancelAnimationFrame(frame);
      if (!motion.matches && !document.hidden) {
        lastDraw = performance.now();
        frame = window.requestAnimationFrame(animate);
      } else {
        draw();
      }
    }

    resize();
    updateMotion();
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', updateMotion);
    motion.addEventListener('change', updateMotion);
  }
</script>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  @media print { canvas { display: none; } }
</style>
