<canvas id="ascii-background" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#ascii-background');
  const context = canvas?.getContext('2d');

  if (canvas && context) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const glyphs = '.:;-=+*#%@';
    const cellWidth = 8;
    const cellHeight = 11;
    const fontSize = 9;
    const frameInterval = 1000 / 15;
    const hiddenMessage = 'Wuvu Daby Dirl';
    let width = 0;
    let height = 0;
    let frame = 0;
    let lastDraw = 0;
    let elapsed = 0;

    // Smooth volumetric noise changes locally over time, producing evolving
    // closed contours instead of directional wave motion.
    function hash(x: number, y: number, z: number) {
      let n = Math.imul(x, 374761393) ^ Math.imul(y, 668265263) ^ Math.imul(z, 1274126177);
      n = Math.imul(n ^ (n >>> 13), 1274126177);
      return ((n ^ (n >>> 16)) >>> 0) / 4294967295;
    }

    function noise(x: number, y: number, z: number) {
      const ix = Math.floor(x), iy = Math.floor(y), iz = Math.floor(z);
      const smooth = (v: number) => v * v * (3 - 2 * v);
      const fx = smooth(x - ix), fy = smooth(y - iy), fz = smooth(z - iz);
      const mix = (a: number, b: number, t: number) => a + (b - a) * t;
      const plane = (k: number) => mix(
        mix(hash(ix, iy, k), hash(ix + 1, iy, k), fx),
        mix(hash(ix, iy + 1, k), hash(ix + 1, iy + 1, k), fx), fy);
      return mix(plane(iz), plane(iz + 1), fz);
    }

    // Render the small glyphs once; each frame only copies these crisp tiles.
    const atlas = document.createElement('canvas');
    const atlasContext = atlas.getContext('2d');
    const tileRatio = Math.min(window.devicePixelRatio || 1, 2);
    const tileWidth = Math.ceil(cellWidth * tileRatio);
    const tileHeight = Math.ceil(cellHeight * tileRatio);
    atlas.width = tileWidth * glyphs.length;
    atlas.height = tileHeight * 8;
    if (atlasContext) {
      atlasContext.font = `${fontSize * tileRatio}px ui-monospace, Menlo, Consolas, monospace`;
      atlasContext.textAlign = 'center';
      atlasContext.textBaseline = 'middle';
      for (let shade = 0; shade < 8; shade++) {
        atlasContext.fillStyle = `rgba(154, 166, 171, ${0.05 + shade * 0.021})`;
        for (let glyph = 0; glyph < glyphs.length; glyph++) {
          atlasContext.fillText(glyphs[glyph], (glyph + 0.5) * tileWidth, (shade + 0.5) * tileHeight);
        }
      }
    }

    function draw() {
      if (!canvas || !context || !atlasContext) return;
      context.clearRect(0, 0, width, height);

      // Sample the field on a coarse grid, then interpolate for every character.
      const spacing = 20;
      const columns = Math.ceil(width / spacing) + 1;
      const rows = Math.ceil(height / spacing) + 1;
      const field = new Float32Array(columns * rows);
      const t = elapsed * 0.16;
      const messageX = Math.max(0, Math.floor((width - 25) / cellWidth) - hiddenMessage.length);
      const messageY = Math.max(0, Math.floor((height - 28) / cellHeight));
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          const x = col * spacing / 180, y = row * spacing / 180;
          field[row * columns + col] =
            noise(x, y, t) * 0.57
            + noise(x * 2.1 + 13, y * 2.1 + 7, t * 1.2) * 0.28
            + noise(x * 4.3 + 31, y * 4.3 + 19, t * 0.8) * 0.15;
        }
      }

      for (let y = 0; y < height; y += cellHeight) {
        const row = Math.floor(y / spacing), fy = y / spacing - row;
        for (let x = 0; x < width; x += cellWidth) {
          const col = Math.floor(x / spacing), fx = x / spacing - col;
          const i = row * columns + col;
          const top = field[i] * (1 - fx) + field[i + 1] * fx;
          const bottom = field[i + columns] * (1 - fx) + field[i + columns + 1] * fx;
          const level = (top * (1 - fy) + bottom * fy) * 12;
          const band = level - Math.floor(level);
          const contour = Math.pow(1 - Math.abs(band * 2 - 1), 2);
          const grain = hash(x, y, Math.floor(level * 2));
          const glyph = Math.min(glyphs.length - 1, Math.floor((contour * 0.75 + grain * 0.25) * glyphs.length));
          const shade = Math.min(7, Math.floor(contour * 6 + grain * 2));
          const letter = x / cellWidth - messageX;
          const isMessage = y / cellHeight === messageY
            && letter >= 0 && letter < hiddenMessage.length;
          // Every cell is drawn, keeping the texture dense between contour lines.
          context.globalAlpha = isMessage ? 0 : 1;
          context.drawImage(atlas, glyph * tileWidth, shade * tileHeight,
            tileWidth, tileHeight, x, y, cellWidth, cellHeight);
          if (isMessage) {
            context.globalAlpha = 1;
            context.font = '7px ui-monospace, Menlo, Consolas, monospace';
            context.textAlign = 'center';
            context.textBaseline = 'middle';
            context.fillStyle = 'rgba(154, 166, 171, 0.21)';
            context.fillText(hiddenMessage[letter], x + cellWidth / 2, y + cellHeight / 2);
          }
        }
      }
      context.globalAlpha = 1;
    }

    function resize() {
      if (!canvas || !context) return;
      width = window.innerWidth;
      height = window.innerHeight;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw();
    }

    function animate(now: number) {
      if (now - lastDraw >= frameInterval) {
        // Avoid jumps when returning to a suspended browser tab.
        elapsed += Math.min((now - lastDraw) / 1000, 0.15);
        lastDraw = now;
        draw();
      }
      frame = window.requestAnimationFrame(animate);
    }

    function updateMotion() {
      window.cancelAnimationFrame(frame);
      if (!motion.matches && !document.hidden) {
        lastDraw = performance.now();
        frame = window.requestAnimationFrame(animate);
      } else {
        draw();
      }
    }

    resize();
    updateMotion();
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', updateMotion);
    motion.addEventListener('change', updateMotion);
    window.addEventListener('pagehide', () => window.cancelAnimationFrame(frame));
    window.addEventListener('pageshow', updateMotion);
  }
</script>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  @media print { canvas { display: none; } }
</style>
