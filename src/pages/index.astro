---
import { publications } from '../data/publications';
import AsciiBackground from '../components/AsciiBackground.astro';
import MuMpcLogo from '../components/MuMpcLogo.astro';
import FactorizedConformalLogo from '../components/FactorizedConformalLogo.astro';
import { resolve } from 'node:path';
import { gifDuration } from '../utils/gif-duration';
const portraitGifs = Object.entries(import.meta.glob<string>('../../easter_eggs/**/*.{gif,GIF}', { eager: true, query: '?url', import: 'default' })).map(([path, src]) => ({ src, duration: gifDuration(resolve(process.cwd(), 'src/pages', path)) }));
const seoTitle = 'Devesh Nath | Robotics PhD Student at Georgia Tech';
const seoDescription = 'Devesh Nath is a Robotics PhD student at Georgia Tech researching safe robot control, learned world models, and scalable planning with statistical safety guarantees.';
const siteUrl = 'https://www.deveshnath.com/';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${siteUrl}#website`, url: siteUrl, name: 'Devesh Nath' },
    {
      '@type': 'Person', '@id': `${siteUrl}#person`, name: 'Devesh Nath', url: siteUrl,
      image: `${siteUrl}images/me.jpeg`, description: seoDescription,
      jobTitle: 'Robotics PhD Student',
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Georgia Institute of Technology', url: 'https://www.gatech.edu/' },
      sameAs: ['https://www.linkedin.com/in/deveshnath', 'https://github.com/dvsh-n'],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#151515" />
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Devesh Nath" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}images/me.jpeg`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={`${siteUrl}images/me.jpeg`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />
    <title>{seoTitle}</title>
  </head>
  <body>
    <AsciiBackground />
    <a class="skip-link" href="#about">Skip to content</a>
    <div class="container">
      <header class="header">
        <button class="portrait" type="button" aria-label="Play a random animation" data-gifs={JSON.stringify(portraitGifs)}>
          <img src="/images/me.jpeg" alt="Devesh Nath" width="1200" height="1600" fetchpriority="high" />
        </button>
        <div class="intro">
          <h1>Devesh Nath</h1>
          <p>Third-year PhD Student, Robotics · Georgia Tech</p>
          <p>Trustworthy Robotics Lab</p>
          <p><a class="email" href="mailto:dnath7@gatech.edu">dnath7 [AT] gatech.edu</a></p>
          <nav class="social-links" aria-label="Contact and profiles">
            <a href="/Resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="Open CV" title="Open CV">
              <span>CV</span>
            </a>
            <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/deveshnath" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.2 3a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4ZM3.4 9h3.6v12H3.4V9Zm6 0h3.4v1.6h.1c.5-1 1.7-1.9 3.5-1.9 3.7 0 4.4 2.4 4.4 5.6V21h-3.6v-6c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9.4V9Z" /></svg>
            </a>
            <a target="_blank" rel="noopener noreferrer" href="https://github.com/dvsh-n" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.82c.85 0 1.71.12 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
            </a>
          </nav>
        </div>
      </header>

      <nav class="section-nav" aria-label="Page sections">
        <a href="#about">About</a>
        <a href="#education">Education</a>
        <a href="#publications">Publications</a>
      </nav>

      <main>
        <section class="panel accent-orange" id="about" aria-labelledby="about-title">
          <h2 id="about-title">01 / About</h2>
          <p>I’m Devesh, a third-year Robotics PhD student at <a target="_blank" rel="noopener noreferrer" href="https://www.gatech.edu/">Georgia Tech</a> in the Trustworthy Robotics Lab, advised by <a target="_blank" rel="noopener noreferrer" href="https://glenchou.github.io/">Dr. Glen Chou</a>. I develop methods for capable, provably safe robotic planning and control using control theory, statistics, and learned representations. Scaling data, compute, and tuning mostly pushes us toward a local optimum; the real leap is learning representations that principled methods can exploit. I work on world models, Koopman operators, conformal prediction, and robust control to make real-time planning scale with meaningful safety guarantees.</p>
        </section>

        <section class="panel accent-green" id="education" aria-labelledby="education-title">
          <h2 id="education-title">02 / Education</h2>
          <article class="education-entry">
            <h3>Georgia Institute of Technology</h3>
            <div class="degree"><span>PhD in Robotics</span><span class="date">Aug 2024 – May 2029 (Expected)</span></div>
            <p class="education-detail">Third Year · Trustworthy Robotics Lab</p>
          </article>
          <article class="education-entry">
            <h3>Arizona State University</h3>
            <div class="degree"><span>BSE in Electrical Engineering</span><span class="date">Aug 2020 – May 2024</span></div>
            <p class="education-detail">GPA: 4.00 / 4.00</p>
          </article>
        </section>

        <section class="panel accent-teal" id="publications" aria-labelledby="publications-title">
          <h2 id="publications-title">03 / Publications</h2>
          <div class="papers">
            {publications.map((paper) => (
              <article class="paper" id={paper.slug} aria-labelledby={`${paper.slug}-title`}>
                <div class="figure">
                  {paper.media ? (
                    paper.media.type === 'video' ? (
                      <div class="video-frame">
                        <video src={paper.media.src} autoplay loop muted playsinline disablepictureinpicture disableremoteplayback preload="auto" aria-label={`Research video for ${paper.title}`} />
                      </div>
                    ) : (
                      <img src={paper.media.src} alt={`Research overview for ${paper.title}`} loading="lazy" />
                    )
                  ) : (
                    <div class="media-placeholder" role="img" aria-label={`Image or video placeholder for ${paper.title}`}></div>
                  )}
                </div>
                <div class="paper-content">
                  <h4 id={`${paper.slug}-title`}>{paper.slug === 'micrompc' ? <><MuMpcLogo />{paper.title.replace(/^μMPC/, '')}</> : paper.slug === 'adaptive-conformal-prediction' ? <><span class="faccp-name">FacCP</span>: <FactorizedConformalLogo />{paper.title.replace(/^Factorized Conformal Prediction/, '')}</> : paper.title}</h4>
                  <p class="authors">{paper.authors.split('Devesh Nath').map((part, index) => <>{index > 0 && <strong>Devesh Nath</strong>}{part}</>)}</p>
                  <p class="venue">{paper.venue}{paper.distinction && <> · <span class="distinction">{paper.distinction}</span></>}</p>
                  <div class="paper-buttons">
                    <a class="button" target="_blank" rel="noopener noreferrer" href={paper.paperUrl} data-placeholder={paper.paperUrl === '#' ? '' : undefined} title={paper.paperUrl === '#' ? 'Paper link coming soon' : 'Read the paper'} aria-label={`Paper: ${paper.title}${paper.paperUrl === '#' ? ' (link coming soon)' : ''}`}><span class="button-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6v18h12V7l-4-4Z M14 3v5h4 M9 12h6 M9 16h6" /></svg><span>Paper</span></span><span class="button-soon" aria-hidden="true">Coming Soon!</span></a>
                    <a class="button" target="_blank" rel="noopener noreferrer" href={paper.websiteUrl ?? `/projects/${paper.slug}/`} aria-label={`Project website: ${paper.title}`}><span class="button-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z M3 12h18 M12 3c4 5 4 13 0 18 M12 3c-4 5-4 13 0 18" /></svg><span>Website</span></span><span class="button-soon" aria-hidden="true">Coming Soon!</span></a>
                    <a class="button" target="_blank" rel="noopener noreferrer" href={paper.videoUrl} data-placeholder={paper.videoUrl === '#' ? '' : undefined} title={paper.videoUrl === '#' ? 'Video link coming soon' : 'Watch the video'} aria-label={`Video: ${paper.title}${paper.videoUrl === '#' ? ' (link coming soon)' : ''}`}><span class="button-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" /></svg><span>Video</span></span><span class="button-soon" aria-hidden="true">Coming Soon!</span></a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      </main>
      <footer>Devesh Nath</footer>
    </div>
    <script>
      const portrait = document.querySelector<HTMLButtonElement>('.portrait')!;
      let portraitImage = portrait.querySelector<HTMLImageElement>('img')!;
      const originalPortrait = portraitImage.cloneNode(true) as HTMLImageElement;
      const gifs: { src: string; duration: number }[] = JSON.parse(portrait.dataset.gifs ?? '[]');
      let playing = false;
      let lastGif = '';
      const openSurprise = (event: Event) => {
        event.preventDefault();
        if (playing) return;
        const choices = gifs.filter((gif) => gif.src !== lastGif);
        if (!choices.length) return;
        const selected = choices[Math.floor(Math.random() * choices.length)];
        lastGif = selected.src;
        playing = true;
        const animation = new Image();
        animation.onload = () => {
          portraitImage.src = animation.src;
          portraitImage.alt = 'Surprise animation';
          portrait.classList.add('playing-gif');
          window.setTimeout(() => {
            const restoredPortrait = originalPortrait.cloneNode(true) as HTMLImageElement;
            portraitImage.replaceWith(restoredPortrait);
            portraitImage = restoredPortrait;
            portrait.classList.remove('playing-gif');
            playing = false;
          }, Math.max(2500, selected.duration));
        };
        animation.onerror = () => { playing = false; };
        animation.src = `${selected.src}?play=${Date.now()}`;
      };
      portrait.addEventListener('click', openSurprise);
      portrait.addEventListener('contextmenu', openSurprise);
      // Placeholder links remain on the current publication until real URLs are added.
      document.querySelectorAll<HTMLAnchorElement>('a[data-placeholder]').forEach((link) => {
        let resetTimer: ReturnType<typeof setTimeout>;
        link.addEventListener('click', (event) => {
          event.preventDefault();
          clearTimeout(resetTimer);
          link.classList.add('show-soon');
          resetTimer = setTimeout(() => link.classList.remove('show-soon'), 1500);
        });
      });

      const desktopHover = window.matchMedia('(min-width: 750px) and (hover: hover) and (pointer: fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const motion = new Map<HTMLElement, Animation>();
      const timing = { duration: 520, easing: 'cubic-bezier(.22, 1, .36, 1)' };
      const animate = (element: HTMLElement, frames: Keyframe[]) => {
        if (reducedMotion.matches) return;
        const animation = element.animate(frames, timing);
        motion.set(element, animation);
        animation.onfinish = () => {
          if (motion.get(element) === animation) motion.delete(element);
        };
      };

      document.querySelectorAll<HTMLElement>('.paper').forEach((paper) => {
        const content = paper.querySelector<HTMLElement>('.paper-content')!;
        const figure = paper.querySelector<HTMLElement>('.figure')!;
        let measuredWidth = 0;

        const measure = () => {
          if (!desktopHover.matches) {
            motion.forEach((animation) => animation.cancel());
            motion.clear();
            paper.classList.remove('hover-ready', 'is-expanded');
            measuredWidth = 0;
            return;
          }
          const width = paper.clientWidth;
          if (!width || width === measuredWidth) return;
          measuredWidth = width;

          // Measure both text layouts without moving the visible text or video.
          const probe = content.cloneNode(true) as HTMLElement;
          probe.querySelectorAll('[id]').forEach((element) => element.removeAttribute('id'));
          probe.setAttribute('aria-hidden', 'true');
          probe.inert = true;
          probe.style.cssText = 'position:fixed;left:-10000px;top:0;visibility:hidden;pointer-events:none;height:auto;transition:none;';
          paper.append(probe);
          probe.style.width = `${width * 0.61}px`;
          const compactTextHeight = probe.getBoundingClientRect().height;
          probe.style.width = `${width}px`;
          const fullTextHeight = probe.getBoundingClientRect().height;
          probe.remove();

          const image = figure.querySelector('img');
          const ratio = image?.naturalWidth && image.naturalHeight
            ? image.naturalWidth / image.naturalHeight : 8 / 5;
          const videoTop = Math.ceil(fullTextHeight) + 18;
          paper.style.setProperty('--compact-height', `${Math.ceil(Math.max(compactTextHeight, width * 0.36 / ratio + 3))}px`);
          paper.style.setProperty('--expanded-top', `${videoTop}px`);
          paper.style.setProperty('--expanded-height', `${Math.ceil(videoTop + width / ratio + 3)}px`);
          paper.classList.add('hover-ready');
        };

        const setExpanded = (expanded: boolean) => {
          measure();
          if (!desktopHover.matches || paper.classList.contains('is-expanded') === expanded) return;

          // Read the current visual positions, including any interrupted animation.
          const following = Array.from(document.querySelectorAll<HTMLElement>('.paper, footer'))
            .filter((element) => Boolean(paper.compareDocumentPosition(element) & Node.DOCUMENT_POSITION_FOLLOWING));
          const before = following.map((element) => element.getBoundingClientRect().top);
          const figureTransform = getComputedStyle(figure).transform;
          const contentLeft = content.getBoundingClientRect().left;
          const contentOpacity = getComputedStyle(content).opacity;
          [figure, content, ...following].forEach((element) => {
            motion.get(element)?.cancel();
            motion.delete(element);
          });

          // Commit the destination layout once. Only transforms and opacity animate.
          paper.classList.toggle('is-expanded', expanded);
          const destinationTransform = getComputedStyle(figure).transform;
          const destinationLeft = content.getBoundingClientRect().left;
          const after = following.map((element) => element.getBoundingClientRect().top);
          animate(figure, [{ transform: figureTransform }, { transform: destinationTransform }]);
          animate(content, [
            { transform: `translate3d(${contentLeft - destinationLeft}px, 0, 0)`, opacity: Math.min(Number(contentOpacity), 0.7) },
            { transform: 'translate3d(0, 0, 0)', opacity: 1 },
          ]);
          following.forEach((element, index) => {
            const offset = before[index] - after[index];
            if (Math.abs(offset) > 0.5) animate(element, [
              { transform: `translate3d(0, ${offset}px, 0)` },
              { transform: 'translate3d(0, 0, 0)' },
            ]);
          });
        };
        let collapseTimer: ReturnType<typeof setTimeout> | undefined;
        const cancelCollapse = () => {
          clearTimeout(collapseTimer);
          collapseTimer = undefined;
        };
        figure.addEventListener('pointerenter', () => {
          cancelCollapse();
          setExpanded(true);
        });
        // The image moves during expansion; keep the whole card as the hover area.
        paper.addEventListener('pointerenter', cancelCollapse);
        paper.addEventListener('pointerleave', () => {
          cancelCollapse();
          collapseTimer = setTimeout(() => {
            collapseTimer = undefined;
            if (!paper.matches(':hover')) setExpanded(false);
          }, 200);
        });
        desktopHover.addEventListener('change', measure);
        new ResizeObserver(measure).observe(paper);
        figure.querySelector('img')?.addEventListener('load', () => {
          measuredWidth = 0;
          measure();
        });
        document.fonts.ready.then(() => {
          measuredWidth = 0;
          measure();
        });
        measure();
      });
    </script>
  </body>
</html>

<style>
  @font-face { font-family: 'Lato'; src: url('/fonts/Lato-Bold.ttf') format('truetype'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Lato'; src: url('/fonts/Lato-Regular.ttf') format('truetype'); font-weight: 400; font-style: normal; font-display: swap; }
  :global(*) { box-sizing: border-box; }
  :global(html) {
    color-scheme: dark;
    background: #0a0a0a;
    --panel: #1c1c1d;
    --ink: #dededc;
    --muted: #a4a3a2;
    --line: #353432;
    --orange: #d88864;
    --teal: #91bdd0;
    --green: #aed19c;
    scroll-padding-top: 88px;
  }
  :global(body) { margin: 0; font-family: 'Roboto Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 15px; line-height: 1.75; color: var(--ink); -webkit-font-smoothing: antialiased; }
  :global(::selection) { background: #a95431; color: #fff; }
  :global(a) { color: var(--orange); font-weight: 700; text-decoration: none; }
  :global(a:hover) { color: #f1b89b; }
  :global(a:focus-visible) { outline: 2px solid var(--orange); outline-offset: 5px; border-radius: 2px; }
  h1, h2, h3, h4, p { margin: 0; }
  .container { position: relative; z-index: 1; width: 86%; max-width: 960px; margin: 0 auto; }
  .header { display: grid; grid-template-columns: 22% 1fr; gap: 4%; align-items: center; margin: 50px 0 60px; }
  .portrait { display: block; padding: 0; width: 100%; aspect-ratio: 1; overflow: hidden; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; cursor: pointer; }
  .portrait.playing-gif img { transform: none; object-fit: contain; object-position: center; }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; transform: scale(1.85); transform-origin: 50% 55%; }
  h1 { margin-bottom: 4px; font-size: 34px; font-weight: 700; letter-spacing: -.8px; line-height: 1.2; }
  .intro p { font-size: 13px; line-height: 1.75; color: var(--muted); }
  .email { color: inherit; font-weight: 400; }
  .social-links { display: flex; gap: 13px; align-items: center; margin-top: 9px; }
  .social-links a { display: inline-flex; justify-content: center; width: 22px; padding: 3px 0; color: var(--ink); }
  .social-links a:hover { color: var(--orange); }
  .social-links svg { width: 22px; height: 22px; }
  .social-links a > span { line-height: 22px; transform: translateY(2px); }
  .section-nav { position: relative; z-index: 5; display: flex; align-items: center; gap: 35px; min-height: 65px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: transparent; margin-bottom: 0; }
  .section-nav a { display: flex; align-items: center; min-height: 64px; position: relative; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--ink); }
  .section-nav a::after { content: ''; position: absolute; height: 2px; bottom: 17px; left: 0; width: 100%; background: var(--nav-accent); transform: scaleX(0); transition: transform .15s ease; }
  .section-nav a[href="#about"] { --nav-accent: var(--orange); }
  .section-nav a[href="#education"] { --nav-accent: var(--green); }
  .section-nav a[href="#publications"] { --nav-accent: var(--teal); }
  .section-nav a:hover, .section-nav a:focus-visible { color: var(--nav-accent); outline-color: var(--nav-accent); }
  .section-nav a:hover::after, .section-nav a:focus-visible::after { transform: scaleX(1); }
  .panel { background: var(--panel); border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 6px; padding: 30px 40px 26px; margin-bottom: 24px; }
  .accent-orange { --accent: var(--orange); }
  .accent-green { --accent: var(--green); }
  .accent-teal { --accent: var(--teal); }
  h2 { color: var(--accent); font-size: 16px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; line-height: 1.35; margin-bottom: 16px; }
  .education-entry h3 { font-size: 15px; line-height: 1.7; font-weight: 700; }
  .education-entry + .education-entry { margin-top: 22px; padding-top: 22px; border-top: 1px dashed var(--line); }
  .degree { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 5px 12px; padding: 10px 0 6px; font-size: 13px; }
  .degree > span:first-child::before { content: ''; display: inline-block; vertical-align: 3px; width: 12px; height: 2px; background: var(--accent); margin-right: 10px; }
  .date { color: var(--teal); background: #242e32; border-radius: 3px; padding: 0 8px; font-size: 11px; }
  .education-detail { margin-left: 22px; color: var(--muted); font-size: 12px; }
  .paper { display: grid; grid-template-columns: 36% minmax(0, 1fr); gap: 3%; margin-bottom: 26px; scroll-margin-top: 20px; }
  .paper:last-child { margin-bottom: 0; }
  .figure { padding-top: 3px; }
  .media-placeholder { aspect-ratio: 8 / 5; width: 100%; background: #222223; border: 1px solid var(--line); border-radius: 4px; }
  .figure img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; }
  .video-frame { position: relative; isolation: isolate; width: 100%; aspect-ratio: 8 / 5; overflow: hidden; border: 1px solid var(--line); border-radius: 6px; background: #24282b; }
  .figure video { display: block; width: 100%; height: 100%; object-fit: contain; background: transparent; }
  .paper h4 { font-size: 15px; line-height: 1.7; font-weight: 700; margin-bottom: 2px; overflow-wrap: anywhere; }
  .authors { font-size: 13px; line-height: 1.7; color: var(--muted); margin-bottom: 2px; }
  .authors strong { color: var(--ink); font-weight: 700; }
  .venue { color: var(--teal); font-size: 13px; font-style: italic; line-height: 1.7; }
  .distinction { color: #ef8585; }
  .faccp-name { color: #f0a35e; }
  .paper-buttons { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }
  .button { position: relative; isolation: isolate; overflow: hidden; display: inline-grid; place-items: center; width: 112px; height: 42px; padding: 0; border: 1px solid #a6a5a2; border-radius: 24px; color: var(--ink); font-size: 12px; font-weight: 500; line-height: 1.4; transition: color .3s, border-color .3s; }
