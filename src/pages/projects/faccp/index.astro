---
import videoUrl from './FacCp.mp4?url';
import relatedWorkUrl from './related-work.mp4?url';
import method0Url from './method_videos/01-reachable-set-prediction.mp4?url';
import method1Url from './method_videos/02-representation-learning.mp4?url';
import method2Url from './method_videos/03-local-residual-retrieval.mp4?url';
import method3Url from './method_videos/04-local-residual-weights.mp4?url';
import method4Url from './method_videos/05-local-geometry-retrieval.mp4?url';
import method5Url from './method_videos/06-conformalized-local-geometry.mp4?url';
import method6Url from './method_videos/07-local-guarantees.mp4?url';
import geometryExperimentUrl from './experiment_videos/01-multiple-geometries.mp4?url';
import capacityExperimentUrl from './experiment_videos/02-data-and-capacity.mp4?url';
import reachabilityExperimentUrl from './experiment_videos/03-3d-reachability.mp4?url';
import geometryPosterUrl from './experiment_videos/01-multiple-geometries.jpg?url';
import capacityPosterUrl from './experiment_videos/02-data-and-capacity.jpg?url';
import reachabilityPosterUrl from './experiment_videos/03-3d-reachability.jpg?url';
import intersectionPlotUrl from './experiment_plots/multimodal-intersection-and-turn.svg?url';
import neighborsPlotUrl from './experiment_plots/multimodal-neighbors.svg?url';
import singleModePlotUrl from './experiment_plots/single-mode.svg?url';
import FactorizedConformalLogo from '../../../components/FactorizedConformalLogo.astro';
const methodSteps = [
  { title: 'Reachable Set Prediction', url: method0Url, explanation: 'Prediction sets should adapt to how prediction errors vary with the query. Computing retrieval weights directly from distances in the input X can be unreliable: irrelevant features affect those distances without providing information about uncertainty. In high dimensions, this makes relevant reference examples harder to identify and residual distributions harder to estimate. The localization metric must therefore reflect changes in uncertainty, rather than all variation in the input.' },
  { title: 'Representation Learning', url: method1Url, explanation: 'FacCP learns a lower-dimensional representation for computing retrieval weights. The representation is trained with an energy-score objective that evaluates the residual distribution retrieved for each query. Its target is the full conditional residual law, rather than a particular covariance or set shape. By retaining uncertainty-relevant information and suppressing irrelevant variation, the learned space can make localization more statistically efficient.' },
  { title: 'Local Residual Law · Retrieve Similar Errors', url: method2Url, explanation: 'For a new query, FacCP locates reference examples nearby in the learned representation. Proximity is trained to reflect similarity in conditional residual distributions, so examples can be informative even when their original inputs differ substantially. Only the queries are embedded: the associated residuals remain in their original space. The representation determines which residuals to emphasize without compressing their multivariate structure.' },
  { title: 'Local Residual Law · Weight the Residuals', url: method3Url, explanation: 'FacCP assigns each reference residual a normalized weight that decreases with distance from the query in the learned space. A temperature parameter controls how local the weighting is. The weighted collection of observed residuals estimates the query’s conditional residual law. This distribution is the shared intermediate object used to construct local geometry, separating uncertainty estimation from the choice of prediction-set family.' },
  { title: 'Local Geometry Retrieval', url: method4Url, explanation: 'A geometry constructor converts the retrieved residual law into a family of nested sets. For ellipsoids, the weighted residual mean and covariance determine the center, orientation, and relative axis lengths; an inflation parameter controls overall size. The same learned representation also supports hyperboxes, zonotopes, and density-based sets without retraining. Each constructor is then calibrated separately.' },
  { title: 'Conformalized Local Geometry', url: method5Url, explanation: 'After fixing the learned geometry, FacCP scores each independent calibration example by the smallest inflation needed to contain its residual. The full calibration sample determines one global conformal threshold, while each query retains its own local shape. Under exchangeability, the resulting prediction set has finite-sample marginal coverage regardless of retrieval accuracy. The same calibrated set also admits the local coverage bounds described next.' },
  { title: 'Local Guarantees', url: method6Url, explanation: 'For one global threshold to be meaningful locally, the score distributions must be comparable across queries. Under the paper’s geometry-approximation condition, error in local geometry bounds how much these distributions differ, a property called approximate pivotality. The resulting local coverage bound separates geometry error from finite calibration error. Marginal coverage follows from conformal calibration; approximate local coverage additionally requires accurate geometry under the stated assumptions.' },
];
const experiments = [
  {
    title: "One Representation, Four Set Geometries",
    url: geometryExperimentUrl, poster: geometryPosterUrl, width: 2560, height: 990,
    paragraphs: [
      "One learned representation supports ellipsoids, hyperboxes, zonotopes, and density-based sets without retraining. On planar quadcopter rollouts, FacCP adapts each geometry to the query and produces tighter sets across all four families. Each family is calibrated separately to target 99% simultaneous coverage of the full 100-step trajectory.",
      "The benefit comes from learning which errors are relevant. With 806 input dimensions, raw-input retrieval gives nearly the same ellipsoid log volume as global geometry (−26.66 versus −25.82). Learned retrieval reaches −33.25 with 99.1% measured coverage, showing how a suitable representation can make local adaptation more effective.",
    ],
  },
  {
    title: "Tighter Sets with Less Data and Capacity",
    url: capacityExperimentUrl, poster: capacityPosterUrl, width: 2560, height: 990,
    paragraphs: [
      "FacCP shows its largest gains when training data or model capacity is limited. At roughly 5,000 learned parameters, it produces sets over 1,000× smaller than resCONTRA at comparable coverage; the low-capacity comparison with covariance prediction gives over 250× smaller sets. The capacity sweeps match learned parameter counts and use the same trajectory-level calibration procedure.",
      "With 20% of the training data, sets are 211× smaller than resCONTRA and 46× smaller than covariance prediction while maintaining coverage. Retrieving observed residuals lets the model focus on learning which examples to use. The advantage narrows as direct models receive more data and capacity.",
    ],
  },
  {
    title: "High-Dimensional Robotic Reachability",
    url: reachabilityExperimentUrl, poster: reachabilityPosterUrl, width: 2560, height: 990,
    paragraphs: [
      "The same construction extends to 200-step 3D quadcopter rollouts: 3,212 input coordinates and a 2,400-dimensional residual trajectory. FacCP reduces mean per-step 12D log volume from −52.52 to −68.99, with measured whole-trajectory coverage of 99.3%, versus 99.4% for global geometry. The animation shows coordinate projections of these reachable sets.",
      "Calibration targets the complete trajectory, rather than individual coordinates or time steps. Retrieval remains particularly effective under limited data and capacity, but the comparison also shows its scope: with enough training data and model capacity, resCONTRA closes the gap and can produce tighter sets.",
    ],
  },
  {
    title: "Multimodal Driving, Whole-Path Coverage",
    plots: [
      { url: intersectionPlotUrl, width: 1635.88, height: 491.228, label: 'Multimodal prediction at an intersection and a sharp turn' },
      { url: neighborsPlotUrl, width: 1633.21, height: 286.571, label: 'Multimodal prediction with neighboring agents' },
    ],
    paragraphs: [
      "FacCP adapts uncertainty around six fixed candidate paths from an MTR forecaster, covering a six-second driving horizon. At the 95% target, it reduces mean footprint by 14.9% relative to global SNSA, from 683.8 to 581.9 m²·s. Measured whole-path coverage is 94.46% versus 95.19%, so the smaller footprint comes with a modest empirical coverage difference.",
      "Coverage here requires one candidate tube to contain the entire observed future, without switching candidates along the way. FORCE-OPT produces smaller footprints but reaches 62.29% on this whole-path metric; its calibration targets individual time steps. The plots illustrate why compactness and the coverage event need to be considered together.",
    ],
  },
  {
    title: "Single-Mode Driving, Smaller Footprints",
    plots: [
      { url: singleModePlotUrl, width: 1633.21, height: 286.571, label: 'Single-mode prediction compared with global SNSA, NLE, and MVCS' },
    ],
    paragraphs: [
      "Tighter tubes also appear when only the highest-probability forecast is retained. At the 97% target, FacCP reduces mean footprint from 3,356.1 to 2,310.1 m²·s—about 31%—with measured whole-path coverage of 97.53%, versus 97.63% for global SNSA. In the illustrated scene, both cover the observed trajectory, while the local tube uses 76.7% less footprint.",
      "This comparison measures spatial occupancy over time. NLE and MVCS are shown as projections of joint trajectory ellipsoids: a wide projection can still belong to a compact joint set because it captures dependencies across time. The footprint comparison therefore describes spatial tightness, rather than a ranking of joint trajectory volumes.",
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#151515" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/projects/faccp/favicon.svg?v=2" />
    <title>FacCP</title>
  </head>
  <body>
    <main>
      <header>
        <h1><span class="fac-cp">FacCP</span></h1>
        <p class="subtitle"><FactorizedConformalLogo /> Via Learned Residual-Law Retrieval</p>
        <p class="authors"><a href="/">Devesh Nath</a><span aria-hidden="true">·</span><span>Rahul Rustagi</span><span aria-hidden="true">·</span><span>Glen Chou</span></p>
        <nav aria-label="Project resources">
          {[
            { label: 'Paper', path: 'M14 3H6v18h12V7l-4-4Z M14 3v5h4 M9 12h6 M9 16h6' },
            { label: 'Code', path: 'm8 7-5 5 5 5 M16 7l5 5-5 5 M14 4l-4 16' },
            { label: 'Video', path: 'm8 5 11 7-11 7V5Z' },
          ].map(({ label, path }) => (
            label === 'Video' ? (
              <a href="#video" aria-label="Watch the summary video"><span class="resource-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg><span>{label}</span></span></a>
            ) : (
            <button type="button" aria-disabled="true" aria-label={`${label}: Coming Soon!`}>
              <span class="resource-label" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={path} /></svg><span>{label}</span></span>
              <span class="soon" aria-hidden="true">Coming Soon!</span>
            </button>
            )
          ))}
        </nav>
      </header>
      <section id="video" aria-label="FacCP full presentation">
        <h2>Summary</h2>
        <video controls autoplay muted playsinline preload="auto" aria-label="FacCP full presentation video">
          <source src={videoUrl} type="video/mp4" />
          Your browser does not support embedded video. <a href={videoUrl}>Download the video</a>.
        </video>
      </section>
      <section class="abstract" aria-labelledby="abstract-title">
        <h2 id="abstract-title">Abstract</h2>
        <p>Local uncertainty. Global calibration. <span class="fac-cp">FacCP</span> builds prediction sets that adapt to query-dependent uncertainty in high dimensions. It learns a representation that brings examples with similar residual distributions together, then retrieves relevant residuals to estimate each query’s uncertainty. This local residual law determines the set’s shape; a single global conformal quantile calibrates its inflation, preserving finite-sample marginal coverage under exchangeability while using the entire calibration sample. The same learned representation supports ellipsoids, hyperboxes, zonotopes, and density-based sets without retraining.</p>
        <p><span class="fac-cp">FacCP</span> connects the quality of local uncertainty geometry to local coverage: under a geometry-approximation condition, better geometry bounds how much the score distribution varies across queries. Experiments show why local calibration alone cannot repair a misspecified shape. Across high-dimensional robotic reachability and multimodal autonomous driving, <span class="fac-cp">FacCP</span> produces tighter calibrated sets, with particularly strong data and parameter efficiency when training data or model capacity is limited.</p>
      </section>
      <section class="why" aria-labelledby="why-title">
        <h2 id="why-title">Why <span class="fac-cp">FacCP</span>?</h2>
        <div class="related-work-media">
          <video id="related-work-video" muted playsinline preload="auto" disablepictureinpicture disableremoteplayback tabindex="-1" aria-label="Related work compared with FacCP" aria-describedby="why-comparisons">
            <source src={relatedWorkUrl} type="video/mp4" />
          </video>
        </div>
        <div class="comparison-carousel" role="region" aria-roledescription="carousel" aria-label="Why FacCP comparisons" tabindex="0">
          <button class="comparison-arrow previous" type="button" aria-label="Previous comparison" aria-controls="why-comparisons" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
          <div id="why-comparisons" class="comparisons" aria-live="polite">
          <article class="comparison-card" role="group" aria-roledescription="slide" aria-label="1 of 4">
            <h3><span class="comparison-number">1 / 4</span><span>Local calibration</span></h3>
            <p>Estimating a separate calibration threshold near each query can leave too few relevant examples, especially in high dimensions. Changing the threshold also cannot recover a shape that the chosen score cannot express. <span class="fac-cp">FacCP</span> uses local residuals, the predictor’s errors, to build the shape, then uses the entire calibration sample to choose one global inflation threshold.</p>
          </article>
          <article class="comparison-card" role="group" aria-roledescription="slide" aria-label="2 of 4" hidden>
            <h3><span class="comparison-number">2 / 4</span><span>Scalar-score rectification</span></h3>
            <p>PIT-CP and Rectified CP adjust a chosen scalar score to improve local coverage. But once a score has discarded direction or multiple possible outcomes, adjusting that number cannot bring them back. Rescaling a distance-based ball, for example, cannot turn it into a tilted ellipsoid. <span class="fac-cp">FacCP</span> learns the residual distribution and constructs the geometry before reducing it to a score.</p>
          </article>
          <article class="comparison-card" role="group" aria-roledescription="slide" aria-label="3 of 4" hidden>
            <h3><span class="comparison-number">3 / 4</span><span>Localized scores · SLCP</span></h3>
            <p>SLCP adapts a chosen scalar-score distribution using nearby examples, but its neighborhoods depend on the chosen features and kernel. Irrelevant features can obscure which examples share the same uncertainty, while scalar scores cannot recover geometry they discard. <span class="fac-cp">FacCP</span> explicitly learns a space for retrieving similar multivariate errors, adapting the set’s shape before reducing it to a score.</p>
          </article>
          <article class="comparison-card" role="group" aria-roledescription="slide" aria-label="4 of 4" hidden>
            <h3><span class="comparison-number">4 / 4</span><span>Set-specific learning</span></h3>
            <p>Learning geometry directly can tie the model to one set family and be data- and parameter-inefficient for high-dimensional structured outputs. <span class="fac-cp">FacCP</span> retrieves a residual distribution instead: one learned representation supports ellipsoids, hyperboxes, zonotopes, and density-based sets without retraining, with separate conformal calibration for each constructor. This reuse is especially useful when training data or model capacity is limited.</p>
          </article>
        </div>
          <button class="comparison-arrow next" type="button" aria-label="Next comparison" aria-controls="why-comparisons"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
        </div>
        <p class="comparison-citations"><small>References: LCP — Guan (2023); RLCP — Hore &amp; Barber (2025); PIT-CP — Laplante (2026); Rectified CP — Plassier et al. (2025a); SLCP — Han et al. (2022); CP-SLS-MPC — Srinivasan et al. (2026).</small></p>
      </section>
      <section class="method" aria-labelledby="method-title">
        <h2 id="method-title">Method</h2>
        <div class="method-carousel" role="region" aria-roledescription="carousel" aria-label="Method breakdown" tabindex="0">
          <button class="method-arrow previous" type="button" aria-label="Previous method step" aria-controls="method-slides" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
          </button>
          <div id="method-slides">
            {methodSteps.map((step, index) => (
              <figure class="method-card" hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${methodSteps.length}: ${step.title}`}>
                <video muted playsinline preload="auto" aria-label={step.title}>
                  <source src={step.url} type="video/mp4" />
                </video>
                <figcaption class="method-explanation">
                  <h3><span class="method-number">{index + 1} / {methodSteps.length}</span><span>{step.title}</span></h3>
                  <p>{step.explanation.split('FacCP').map((part, partIndex) => <>{partIndex > 0 && <span class="fac-cp">FacCP</span>}{part}</>)}</p>
                </figcaption>
              </figure>
            ))}
          </div>
          <button class="method-arrow next" type="button" aria-label="Next method step" aria-controls="method-slides">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
          </button>
        </div>
      </section>
      <section class="experiments" aria-labelledby="experiments-title">
        <h2 id="experiments-title">Numerical Experiments</h2>
        {experiments.map((experiment, index) => (
          <article class="experiment" aria-labelledby={`experiment-${index}-title`}>
            <h3 id={`experiment-${index}-title`}><span class="experiment-number">{index + 1} / {experiments.length}</span><span>{experiment.title}</span></h3>
            {experiment.plots ? (
              <div class="experiment-plots">
                {experiment.plots.map((plot) => (
                  <figure class="experiment-plot">
                    <img src={plot.url} width={plot.width} height={plot.height} alt={plot.label} loading="lazy" decoding="async" />
                  </figure>
                ))}
              </div>
            ) : (
              <video class="experiment-video" muted playsinline preload="metadata" disablepictureinpicture disableremoteplayback tabindex="-1" poster={experiment.poster} width={experiment.width} height={experiment.height} aria-label={experiment.title} aria-describedby={`experiment-${index}-explanation`}>
                <source src={experiment.url} type="video/mp4" />
              </video>
            )}
            <div class="experiment-explanation" id={`experiment-${index}-explanation`}>
              {experiment.paragraphs.map((paragraph) => (
                <p>{paragraph.split('FacCP').map((part, partIndex) => <>{partIndex > 0 && <span class="fac-cp">FacCP</span>}{part}</>)}</p>
              ))}
            </div>
          </article>
        ))}
      </section>
      <section class="citation" aria-labelledby="citation-title">
        <h2 id="citation-title">Cite <span class="fac-cp">FacCP</span></h2>
        <div class="citation-block">
          <pre><code id="citation-text">{`@misc{FacCP_2026,
  title = {Factorized Conformal Prediction via Learned Residual-Law Retrieval},
  author = {Nath, Devesh and Rustagi, Rahul and Chou, Glen},
  note = {Preprint},
  year = {2026}
}`}</code></pre>
          <button class="copy-citation" type="button" aria-label="Copy citation">Copy</button>
        </div>
      </section>
    </main>
    <script>
      const copyCitation = document.querySelector<HTMLButtonElement>('.copy-citation')!;
      copyCitation.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(document.querySelector('#citation-text')?.textContent ?? '');
          copyCitation.textContent = 'Copied!';
        } catch {
          copyCitation.textContent = 'Unable to copy';
        }
        window.setTimeout(() => { copyCitation.textContent = 'Copy'; }, 1500);
      });
      const relatedVideo = document.querySelector<HTMLVideoElement>('#related-work-video')!;
      let relatedFinished = false;
      const relatedObserver = new IntersectionObserver(([entry]) => {
        if (relatedFinished) return;
        if (entry.isIntersecting) relatedVideo.play().catch(() => {});
        else relatedVideo.pause();
      }, { threshold: 0.25 });
      relatedVideo.loop = false;
      relatedVideo.addEventListener('ended', () => {
        relatedFinished = true;
        relatedVideo.pause();
        relatedObserver.disconnect();
      }, { once: true });
      relatedObserver.observe(relatedVideo);

      const carousel = document.querySelector<HTMLElement>('.comparison-carousel')!;
      const cards = [...carousel.querySelectorAll<HTMLElement>('.comparison-card')];
      const previous = carousel.querySelector<HTMLButtonElement>('.previous')!;
      const next = carousel.querySelector<HTMLButtonElement>('.next')!;
      let activeComparison = 0;
      const showComparison = (index: number) => {
        if (index < 0 || index >= cards.length) return;
        activeComparison = index;
        cards.forEach((card, i) => { card.hidden = i !== index; });
        previous.disabled = index === 0;
        next.disabled = index === cards.length - 1;
      };
      previous.addEventListener('click', () => showComparison(activeComparison - 1));
      next.addEventListener('click', () => showComparison(activeComparison + 1));
      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          showComparison(activeComparison + (event.key === 'ArrowLeft' ? -1 : 1));
        }
      });

      const methodCarousel = document.querySelector<HTMLElement>('.method-carousel')!;
      const methodCards = [...methodCarousel.querySelectorAll<HTMLElement>('.method-card')];
      const methodPrevious = methodCarousel.querySelector<HTMLButtonElement>('.previous')!;
      const methodNext = methodCarousel.querySelector<HTMLButtonElement>('.next')!;
      let active = 0;
      let visible = false;
      const finished = new WeakSet<HTMLVideoElement>();
      document.querySelectorAll<HTMLVideoElement>('#video video, .method-card video').forEach((video) => {
        video.loop = false;
        video.addEventListener('ended', () => {
          finished.add(video);
          video.pause();
        });
      });
      const updatePlayback = () => methodCards.forEach((card, index) => {
        const video = card.querySelector('video')!;
        if (index === active && visible && !finished.has(video) && !video.ended) video.play().catch(() => {});
        else video.pause();
      });
      const showStep = (index: number) => {
        if (index < 0 || index >= methodCards.length) return;
        active = index;
        methodCards.forEach((card, i) => {
          card.hidden = i !== active;
          if (i === active) {
            const video = card.querySelector('video')!;
            finished.delete(video);
            video.currentTime = 0;
          }
        });
        methodPrevious.disabled = active === 0;
        methodNext.disabled = active === methodCards.length - 1;
        updatePlayback();
      };
      methodPrevious.addEventListener('click', () => showStep(active - 1));
      methodNext.addEventListener('click', () => showStep(active + 1));
      methodCarousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          showStep(active + (event.key === 'ArrowLeft' ? -1 : 1));
        }
      });
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        updatePlayback();
      }, { threshold: 0.25 }).observe(methodCarousel);

      document.querySelectorAll<HTMLVideoElement>('.experiment-video').forEach((video) => {
        let completed = false;
        const observer = new IntersectionObserver(([entry]) => {
          if (completed) return;
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        }, { threshold: 0.25 });
        video.loop = false;
        video.addEventListener('ended', () => {
          completed = true;
          video.pause();
          observer.disconnect();
        }, { once: true });
        observer.observe(video);
      });

      document.querySelectorAll<HTMLButtonElement>('nav button').forEach((button) => {
        let resetTimer: ReturnType<typeof setTimeout>;
        button.addEventListener('click', () => {
          clearTimeout(resetTimer);
          button.classList.add('show-soon');
          resetTimer = setTimeout(() => button.classList.remove('show-soon'), 1500);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Lato'; src: url('/fonts/Lato-Regular.ttf') format('truetype'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Lato'; src: url('/fonts/Lato-Bold.ttf') format('truetype'); font-weight: 700; font-display: swap; }
  html { color-scheme: dark; background: #0a0a0a; min-height: 100%; }
  body { margin: 0; color: #f4f7fb; font-family: 'Lato', sans-serif; -webkit-font-smoothing: antialiased; }
  main { width: min(100% - 64px, 1000px); margin: 0 auto; padding: 80px 0 72px; }
  header { text-align: center; }
  h1 { margin: 0; color: #f0a35e; font-size: clamp(56px, 8vw, 88px); font-weight: 700; letter-spacing: -.035em; line-height: 1.15; text-wrap: balance; }
  .subtitle { margin: 24px 0 0; font-size: clamp(24px, 3.5vw, 36px); line-height: 1.4; text-wrap: balance; }
  .authors { display: flex; align-items: center; justify-content: center; gap: 15px; margin: 24px 0 0; color: #b7c0c8; font-size: 17px; line-height: 1.6; }
  .authors a { color: inherit; text-decoration: none; }
  .authors a:hover { color: #f0a35e; }
  .authors > span[aria-hidden] { color: #55616c; }
  nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin: 29px 0 48px; }
  nav :is(button, a) { position: relative; isolation: isolate; overflow: hidden; display: inline-grid; place-items: center; width: 112px; height: 42px; padding: 0; flex: 0 0 112px; border: 1px solid #343c43; border-radius: 24px; background: #1b2025; color: #e5ebef; font: 700 14px/1.4 'Lato', sans-serif; cursor: default; transition: border-color .3s; }
  nav :is(button, a)::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(240 163 94 / 12%); transform: translateY(101%); transition: transform .3s cubic-bezier(.22, 1, .36, 1); }
  nav :is(button, a) > span { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; transition: opacity .2s, transform .3s; }
  nav :is(button, a) .resource-label { display: grid; grid-template-columns: 16px 38px; align-content: center; justify-content: center; align-items: center; gap: 8px; line-height: 16px; }
  .resource-label > span { display: block; text-align: left; }
  nav :is(button, a) .soon { opacity: 0; transform: translateY(8px); color: #f0a35e; font-size: 11px; letter-spacing: .3px; white-space: nowrap; }
  nav :is(button, a):is(:hover, :focus-visible, .show-soon) { border-color: #f0a35e; }
