---
import { publications } from '../../../data/publications';
import FactorizedConformalLogo from '../../../components/FactorizedConformalLogo.astro';
const project = publications.find((paper) => paper.slug === 'adaptive-conformal-prediction')!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#151515" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/projects/adaptive-conformal-prediction/favicon.svg?v=2" />
    <title>FacCP</title>
  </head>
  <body>
    <main>
      <h1><FactorizedConformalLogo /></h1>
      <p class="subtitle">Via Learned Residual-Law Retrieval</p>
    </main>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Lato'; src: url('/fonts/Lato-Regular.ttf') format('truetype'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Lato'; src: url('/fonts/Lato-Bold.ttf') format('truetype'); font-weight: 700; font-display: swap; }
  html { color-scheme: dark; background: #0a0a0a; min-height: 100%; }
  body { margin: 0; color: #f4f7fb; font-family: 'Lato', sans-serif; -webkit-font-smoothing: antialiased; }
  main { width: min(100% - 48px, 1000px); margin: 0 auto; padding: 80px 0; text-align: center; }
  h1 { margin: 0; font-size: clamp(40px, 6vw, 68px); line-height: 1.15; text-wrap: balance; }
  .subtitle { margin: 24px 0 0; font-size: clamp(24px, 3.5vw, 36px); line-height: 1.4; text-wrap: balance; }
</style>
